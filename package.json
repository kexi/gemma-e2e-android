{
  "name": "gemma-e2e-android",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "bun run scripts/run-if-sources.ts oxlint",
    "fmt": "bun run scripts/run-if-sources.ts oxfmt",
    "fmt:check": "bun run scripts/run-if-sources.ts oxfmt --check",
    "typecheck": "bun run scripts/run-if-sources.ts --typecheck",
    "preinstall": "npx only-allow bun",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3"
  }
}
