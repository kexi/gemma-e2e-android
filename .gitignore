.direnv/
result
result-*
.DS_Store
node_modules/

# Expo prebuild (CNG) output is regenerated from app config, never committed.
apps/*/android/
apps/*/ios/

# Expo CLI local state and the type shim it writes for the project's env vars.
apps/*/.expo/
apps/*/expo-env.d.ts

# Run artifacts: the SQLite history and the screenshots it points at. Both are
# per-machine output of a test run, not source.
var/

# Per-machine runtime config (LLM_MODEL etc.); .env.example documents the keys.
.env

# Vite build output for the dashboard SPA.
apps/*/dist/

# Emulator and Firebase CLI debug logs, written into the repo root on every run.
firestore-debug.log
firebase-debug.log
