# Copy to .env and adjust. `just web` loads this file before starting the API.

# Model identifier as LM Studio's API reports it (`lms ps` / GET /v1/models).
LLM_MODEL=gemma-4-12b

# OpenAI-compatible endpoint the agent talks to. LM Studio's default shown;
# point it at mlx-lm or Ollama to swap backends.
#LLM_BASE_URL=http://localhost:1234/v1

# NDJSON log threshold for the API server: debug|info|warn|error.
#LOG_LEVEL=info

# Per-case screen recording, written to var/videos/{runId}/{caseId}.mp4 and
# played back in the dashboard. Android records with scrcpy; the browser muxes
# its screencast through ffmpeg. On unless set to 0.
#RECORD_RUNS=0

# DevTools port web scenarios drive Chrome through (`just chrome` opens one on
# the default). Set CHROME_ENDPOINT instead to reach a browser elsewhere -- a
# container, or another machine.
#CHROME_PORT=9222
#CHROME_ENDPOINT=http://127.0.0.1:9222
