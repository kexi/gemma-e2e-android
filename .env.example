# Copy to .env and adjust. `just launch-web` loads this file before starting the API.

# Model identifier as LM Studio's API reports it (`lms ps` / GET /v1/models).
# `just launch-model` loads the model under this name, so it only has to describe
# what is loaded; the default names the model `just get-model` downloads.
LLM_MODEL=gemma-4-26b-a4b-qat

# OpenAI-compatible endpoint the agent talks to. LM Studio's default shown;
# point it at mlx-lm or Ollama to swap backends.
#LLM_BASE_URL=http://localhost:1234/v1

# How the screen reaches the model when neither the case nor the scenario says:
# text (compact, numbered; the default) or xml (every node, addressed by ref).
#UI_FORMAT=text

# NDJSON log threshold for the API server: debug|info|warn|error.
#LOG_LEVEL=info

# Per-case screen recording, written to var/videos/{runId}/{caseId}.mp4 and
# played back in the dashboard. Android records with scrcpy; the browser muxes
# its screencast through ffmpeg. On unless set to 0.
#RECORD_RUNS=0

# DevTools port web scenarios drive Chrome through (`just launch-chrome` opens one on
# the default). Set CHROME_ENDPOINT instead to reach a browser elsewhere -- a
# container, or another machine.
#CHROME_PORT=9222
#CHROME_ENDPOINT=http://127.0.0.1:9222

# Where the web live view points when no run is driving it. Both platforms are
# always offered; which one the Device page shows is picked there, not here.
#LIVE_VIEW_URL=http://localhost:5174

# Deadline for one visual accessibility review, retry included, in ms. Unset
# uses the reviewer's default (120000). Raise it for slower models or when a
# case reviews many personas at once.
#ACCESSIBILITY_REVIEW_TIMEOUT_MS=120000
