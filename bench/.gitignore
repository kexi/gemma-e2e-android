# Python caches are regenerated by the benchmark scripts.
__pycache__/
*.py[cod]

# Keep portable summaries and audit records; raw per-machine captures stay local.
tool-call/results/*
!tool-call/results/aggregate.json
!tool-call/results/*audit.json

e2e/results/*
!e2e/results/aggregate.json
!e2e/results/environment.json
!e2e/results/genkit-wire-probe.json
!e2e/results/memory-retrospective.json
!e2e/results/verification.json

e2e/android-results/*
!e2e/android-results/aggregate.json
!e2e/android-results/environment.json
!e2e/android-results/memory-aggregate.json
!e2e/android-results/failure-analysis.json
!e2e/android-results/*verification.json
!e2e/android-results/memory-worker-coverage.json
!e2e/android-results/memory-gguf-worker-coverage.json
!e2e/android-results/memory-31b-mlx-8bit-audit.json
